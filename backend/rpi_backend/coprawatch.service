[Unit]
Description=CopraWatch Raspberry Pi Backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@RUN_USER@
SupplementaryGroups=gpio spi i2c video
WorkingDirectory=@BACKEND_DIR@
EnvironmentFile=/etc/coprawatch/coprawatch.env
ExecStart=@BACKEND_DIR@/.venv/bin/python @BACKEND_DIR@/api_server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=@BACKEND_DIR@

[Install]
WantedBy=multi-user.target
